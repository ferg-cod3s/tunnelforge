---
/**
 * Base Layout
 *
 * Provides the HTML shell for all Astro pages.
 * Includes global styles, fonts, and meta tags.
 */
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Access your terminal sessions from anywhere with TunnelForge'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* CSS Variables for theming */
  :root {
    --bg-primary: #0f0f0f;
    --bg-secondary: #1a1a1a;
    --bg-elevated: #242424;
    --bg-tertiary: #2d2d2d;

    --text: #e5e5e5;
    --text-muted: #a3a3a3;
    --text-dim: #737373;

    --border: #404040;

    --accent-primary: #3b82f6;
    --accent-primary-hover: #2563eb;

    --status-success: #10b981;
    --status-warning: #f59e0b;
    --status-error: #ef4444;
  }

  /* Base styles */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
                 Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: var(--bg-primary);
    color: var(--text);
    line-height: 1.6;
  }

  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    overflow: hidden;
  }

  /* Typography */
  h1, h2, h3, h4, h5, h6 {
    line-height: 1.2;
    font-weight: 600;
  }

  code {
    font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
    background: var(--bg-secondary);
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  /* Scrollbar styling */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--bg-primary);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--bg-tertiary);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--border);
  }

  /* Focus styles */
  *:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* Selection */
  ::selection {
    background: var(--accent-primary);
    color: white;
  }
</style>
