---
/**
 * Main Dashboard Page
 *
 * Astro page that serves as the application shell for TunnelForge.
 * Uses Svelte islands for interactive terminal components with client-side hydration.
 */
import Layout from '../layouts/Layout.astro';
import SessionList from '../components/SessionList.svelte';

const pageTitle = 'TunnelForge - Terminal Sessions';
---

<Layout title={pageTitle}>
  <div class="dashboard-container">
    <!-- Header Section (Static Astro) -->
    <header class="app-header">
      <div class="container">
        <h1 class="app-title">TunnelForge</h1>
        <nav class="app-nav">
          <button id="new-session-btn" class="btn btn-primary">
            New Session
          </button>
          <button id="settings-btn" class="btn btn-secondary">
            Settings
          </button>
        </nav>
      </div>
    </header>

    <!-- Main Content (Svelte Island) -->
    <main class="dashboard-main">
      <SessionList
        client:load
        sessions={[]}
        loading={true}
        hideExited={true}
      />
    </main>
  </div>
</Layout>

<style>
  .dashboard-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    width: 100%;
  }

  .app-header {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .app-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .app-nav {
    display: flex;
    gap: 0.75rem;
  }

  .btn {
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--accent-primary);
    color: white;
    border: none;
  }

  .btn-primary:hover {
    background: var(--accent-primary-hover);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    background: var(--bg-elevated);
  }

  .dashboard-main {
    flex: 1;
    overflow: hidden;
  }
</style>

<script>
  // Client-side JavaScript for static interactions
  document.getElementById('new-session-btn')?.addEventListener('click', () => {
    // Dispatch custom event that Svelte island can listen to
    window.dispatchEvent(new CustomEvent('open-create-dialog'));
  });

  document.getElementById('settings-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-settings'));
  });
</script>
