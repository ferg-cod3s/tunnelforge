{
  "name": "tunnelforge-web",
  "version": "1.0.0",
  "description": "TunnelForge Web Frontend - Svelte 5 + Astro",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && astro check",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/svelte": "^6.0.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "astro": "^5.1.0",
    "svelte": "^5.17.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.20.0",
    "eslint-plugin-svelte": "^2.48.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte-check": "^4.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}
