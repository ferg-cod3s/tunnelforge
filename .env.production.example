# TunnelForge Production Configuration
# ========================================
# ⚠️  SECURE CONFIGURATION FOR PRODUCTION USE
# ========================================

# Server Configuration
# ----------------------------------------
HOST=localhost
PORT=4021
SERVER_NAME=TunnelForge Go Server

# Authentication - REQUIRED FOR PRODUCTION
# ----------------------------------------
ENABLE_AUTH=true
AUTH_REQUIRED=true
ALLOW_LOCAL_BYPASS=false

# 🔑 GENERATE SECURE SECRETS:
# JWT_SECRET: openssl rand -base64 32
# CSRF_SECRET: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_256_BIT_KEY
CSRF_SECRET=REPLACE_WITH_SECURE_256_BIT_KEY

# Security Middleware
# ----------------------------------------
# Rate Limiting (protect against abuse)
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MIN=60

# CSRF Protection (protect against cross-site attacks)
ENABLE_CSRF=true

# IP Whitelisting (optional - uncomment if needed)
ENABLE_IP_WHITELIST=false
# ALLOWED_IPS=10.0.0.0/8,192.168.0.0/16

# Request Logging (audit trail)
ENABLE_REQUEST_LOG=true

# CORS Configuration
# ----------------------------------------
# ⚠️ Replace with your actual domain(s)
# Multiple origins: comma-separated list
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Session Management
# ----------------------------------------
MAX_SESSIONS=50
SESSION_TIMEOUT=1440

# Session Persistence
ENABLE_PERSISTENCE=true
PERSISTENCE_DIR=$HOME/.tunnelforge/sessions
PERSISTENCE_INTERVAL=30s

# File System & Git
# ----------------------------------------
FILESYSTEM_BASE_PATH=$HOME
GIT_BASE_PATH=$HOME

# Push Notifications
# ----------------------------------------
VAPID_KEY_PATH=$HOME/.tunnelforge/keys

# Cloudflare Tunnel (Optional)
# ----------------------------------------
ENABLE_CLOUDFLARE_TUNNELS=false
# CLOUDFLARE_API_TOKEN=your-token-here
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_ZONE_ID=your-zone-id

# Logging
# ----------------------------------------
LOG_LEVEL=warn
LOG_FORMAT=json

# Static Files
# ----------------------------------------
STATIC_DIR=../web/public

# Sentry Error Tracking
# ----------------------------------------
# Backend Sentry DSN - create 'tunnelforge-server' project in Sentry (Bun)
SENTRY_SERVER_DSN=
SENTRY_RELEASE=1.0.0
# Lower sample rates in production to reduce quota usage
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_REPLAYS_SAMPLE_RATE=0.05

# Go Backend Sentry - create 'tunnelforge-go' project in Sentry
SENTRY_GO_DSN=

# ========================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ========================================
# [ ] Replace JWT_SECRET with secure random value
# [ ] Replace CSRF_SECRET with secure random value
# [ ] Update ALLOWED_ORIGINS with your domains
# [ ] Verify ALLOW_LOCAL_BYPASS=false
# [ ] Configure reverse proxy with HTTPS/TLS
# [ ] Set up firewall rules
# [ ] Enable monitoring and alerting
# [ ] Review rate limits for your use case
# [ ] Configure Sentry DSN for error tracking
# [ ] Secure this file (chmod 600)
# [ ] Never commit secrets to version control
