# TunnelForge Development Configuration
# ========================================
# 🔓 INSECURE CONFIGURATION FOR LOCAL DEVELOPMENT ONLY
# ========================================
# ⚠️  WARNING: DO NOT USE IN PRODUCTION OR EXPOSE TO NETWORK
# ⚠️  This configuration allows unauthenticated access
# ========================================

# Server Configuration
# ----------------------------------------
HOST=0.0.0.0
PORT=4021
SERVER_NAME="TunnelForge Go Server (Dev)"

# Authentication - DISABLED FOR DEVELOPMENT
# ----------------------------------------
ENABLE_AUTH=false
AUTH_REQUIRED=false
ALLOW_LOCAL_BYPASS=true

# Development JWT secret (not secure - for testing only)
JWT_SECRET=dev-jwt-secret-not-secure-change-in-production

# Security Middleware (Relaxed)
# ----------------------------------------
# Rate Limiting (disabled for development - too restrictive)
ENABLE_RATE_LIMIT=false
RATE_LIMIT_PER_MIN=1000

# CSRF Protection (disabled for easier testing)
ENABLE_CSRF=false
CSRF_SECRET=dev-csrf-secret-not-secure

# IP Whitelisting (disabled)
ENABLE_IP_WHITELIST=false

# Request Logging (verbose for debugging)
ENABLE_REQUEST_LOG=true

# CORS Configuration (Permissive)
# ----------------------------------------
# Allow all origins in development
ALLOWED_ORIGINS=*

# Session Management
# ----------------------------------------
MAX_SESSIONS=50
SESSION_TIMEOUT=1440

# Session Persistence
ENABLE_PERSISTENCE=true
PERSISTENCE_DIR=$HOME/.tunnelforge/sessions
PERSISTENCE_INTERVAL=30s

# File System & Git
# ----------------------------------------
FILESYSTEM_BASE_PATH=$HOME
GIT_BASE_PATH=$HOME

# Push Notifications
# ----------------------------------------
VAPID_KEY_PATH=$HOME/.tunnelforge/keys

# Cloudflare Tunnel (Disabled in Development)
# ----------------------------------------
ENABLE_CLOUDFLARE_TUNNELS=false

# Logging (Verbose)
# ----------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=text

# Static Files
# ----------------------------------------
STATIC_DIR=../web/public

# Sentry Error Tracking
# ----------------------------------------
# Backend Sentry DSN - tunnelforge-server project (Bun)
SENTRY_SERVER_DSN=https://9f43c806cd915c331753ca7e627ae479@sentry.fergify.work/11
SENTRY_RELEASE=1.0.0-dev
SENTRY_DEBUG=true

# Go Backend Sentry - tunnelforge-go project
SENTRY_GO_DSN=https://00bf7c0e2b55613e91a5bc455298896f@sentry.fergify.work/12

# ========================================
# DEVELOPMENT NOTES
# ========================================
# This configuration is designed for local development only.
# 
# Features:
# - No authentication required
# - Local bypass enabled (X-TunnelForge-Local header)
# - Verbose logging
# - Permissive CORS
# - Higher rate limits
#
# Security Reminders:
# - Only bind to localhost (127.0.0.1)
# - Never expose this configuration to the network
# - Use production configuration for any external access
# - Firewall should block external access to port 4021

# Bun Proxy Server Configuration (Web Frontend)
# ----------------------------------------
WEB_PORT=3001
GO_SERVER_URL=http://localhost:4021
