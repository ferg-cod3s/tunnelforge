{
  "productName": "TunnelForge",
  "version": "1.0.0",
  "identifier": "dev.tunnelforge.windows",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2024 TunnelForge Team",
    "category": "DeveloperTool",
    "shortDescription": "Terminal sharing made simple",
    "longDescription": "TunnelForge allows you to share terminal sessions through any web browser with a beautiful, fast desktop interface.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": null,
        "installMode": "perMachine",
        "languages": ["en-US"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.tunnelforge.dev/windows/{{current_version}}/{{target}}/{{arch}}"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNTZDMzczNUIwQ0I4NUUKUldSZXVBeGJjOE5XdXRHQ0VRTnJPVFZXemxkZnQrTzRQalgxTmdza0pjZzJkN3ZlayswOWFHTG0K"
    }
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "TunnelForge",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
