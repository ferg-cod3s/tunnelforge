#!/bin/bash

# TunnelForge Enterprise Management CLI
# Command-line interface for managing TunnelForge enterprise deployments

set -euo pipefail

# Version and configuration
CLI_VERSION="1.0.0"
CONFIG_FILE="${HOME}/.tunnelforge-enterprise/config"
DEFAULT_SERVER="https://localhost:8443"
DEFAULT_TIMEOUT=30

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Global variables
SERVER_URL=""
API_TOKEN=""
TIMEOUT=""
VERBOSE=""
DRY_RUN=""

# Logging functions
log_info() {
    [[ -n "$VERBOSE" ]] && echo -e "${BLUE}[INFO]${NC} $1" >&2
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1" >&2
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_debug() {
    [[ -n "$VERBOSE" ]] && echo -e "${PURPLE}[DEBUG]${NC} $1" >&2
}

# Display usage information
show_help() {
    cat << EOF
TunnelForge Enterprise Management CLI v${CLI_VERSION}

USAGE:
    tunnelforge-enterprise-cli [OPTIONS] <COMMAND> [SUBCOMMAND] [ARGS]

GLOBAL OPTIONS:
    -s, --server <URL>       Management server URL (default: ${DEFAULT_SERVER})
    -t, --token <TOKEN>       API authentication token
    --timeout <SECONDS>       Request timeout (default: ${DEFAULT_TIMEOUT})
    -v, --verbose            Enable verbose output
    -n, --dry-run           Show what would be done without executing
    -h, --help              Show this help message
    --version               Show version information

COMMANDS:

    # Server Management
    server list              List all managed servers
    server status <ID>       Show server status
    server start <ID>        Start TunnelForge service
    server stop <ID>         Stop TunnelForge service
    server restart <ID>      Restart TunnelForge service
    server deploy <CONFIG>    Deploy to servers
    server update <ID>       Update server software

    # User Management
    user list               List all users
    user create <EMAIL>      Create new user
    user delete <ID>        Delete user
    user update <ID>         Update user information
    user roles <ID>          Show user roles
    user grant <ID> <ROLE>   Grant role to user
    user revoke <ID> <ROLE>  Revoke role from user

    # Policy Management
    policy list             List all policies
    policy create <FILE>     Create new policy
    policy delete <ID>       Delete policy
    policy update <ID> <FILE> Update policy
    policy apply <ID> <TARGET> Apply policy to target
    policy validate <ID>     Validate policy syntax

    # Configuration Management
    config show <TARGET>     Show configuration
    config set <TARGET> <KEY> <VALUE>  Set configuration value
    config get <TARGET> <KEY>  Get configuration value
    config backup <TARGET>    Backup configuration
    config restore <TARGET> <FILE>  Restore configuration

    # Monitoring & Analytics
    monitor status          Show monitoring status
    monitor metrics <TARGET>  Show metrics
    monitor alerts          Show active alerts
    monitor logs <TARGET>   Show logs
    monitor report <TYPE>    Generate report

    # Security & Compliance
    security audit          Run security audit
    security scan <TARGET>   Run security scan
    compliance check        Run compliance check
    compliance report       Generate compliance report

    # Deployment Management
    deployment list        List deployments
    deployment create <FILE> Create deployment
    deployment status <ID>  Show deployment status
    deployment rollback <ID> Rollback deployment

    # Integration Management
    integration list       List integrations
    integration test <TYPE>  Test integration
    integration configure <TYPE> <FILE>  Configure integration

EXAMPLES:
    # List all servers
    tunnelforge-enterprise-cli server list

    # Get server status
    tunnelforge-enterprise-cli -s https://mgmt.company.com server status server-001

    # Create new user
    tunnelforge-enterprise-cli user create user@company.com

    # Deploy configuration
    tunnelforge-enterprise-cli --dry-run server deploy production-config.json

    # Run security audit
    tunnelforge-enterprise-cli security audit

    # Generate compliance report
    tunnelforge-enterprise-cli compliance report --format json > compliance.json

For more detailed help on a specific command, use:
    tunnelforge-enterprise-cli <COMMAND> --help

EOF
}

# Load configuration
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        source "$CONFIG_FILE"
        log_debug "Configuration loaded from $CONFIG_FILE"
    fi
    
    # Set defaults if not configured
    SERVER_URL="${SERVER_URL:-$DEFAULT_SERVER}"
    TIMEOUT="${TIMEOUT:-$DEFAULT_TIMEOUT}"
}

# Save configuration
save_config() {
    local config_dir
    config_dir="$(dirname "$CONFIG_FILE")"
    
    mkdir -p "$config_dir"
    
    cat > "$CONFIG_FILE" << EOF
# TunnelForge Enterprise CLI Configuration
SERVER_URL="$SERVER_URL"
API_TOKEN="$API_TOKEN"
TIMEOUT="$TIMEOUT"
EOF

    chmod 600 "$CONFIG_FILE"
    log_debug "Configuration saved to $CONFIG_FILE"
}

# Make API request
api_request() {
    local method="$1"
    local endpoint="$2"
    local data="${3:-}"
    local response_file="/tmp/tf-api-response-$$"
    
    local curl_cmd=(
        curl
        -s
        -w "%{http_code}"
        -X "$method"
        -H "Authorization: Bearer $API_TOKEN"
        -H "Content-Type: application/json"
        --connect-timeout "$TIMEOUT"
        --max-time "$TIMEOUT"
    )

    if [[ -n "$data" ]]; then
        curl_cmd+=(-d "$data")
    fi

    curl_cmd+=("${SERVER_URL}/api/v1${endpoint}")

    log_debug "API Request: $method $endpoint"
    [[ -n "$data" ]] && log_debug "Data: $data"

    if [[ -z "$DRY_RUN" ]]; then
        local http_code
        http_code=$("${curl_cmd[@]}" 2>/dev/null | tail -c 3)
        
        if [[ "$http_code" =~ ^2 ]]; then
            log_success "API request successful"
            return 0
        else
            log_error "API request failed with HTTP $http_code"
            return 1
        fi
    else
        log_info "DRY RUN: Would execute: ${curl_cmd[*]}"
        return 0
    fi
}

# Server management commands
cmd_server_list() {
    log_info "Listing servers..."
    api_request "GET" "/servers"
}

cmd_server_status() {
    local server_id="$1"
    if [[ -z "$server_id" ]]; then
        log_error "Server ID is required"
        return 1
    fi
    
    log_info "Getting status for server: $server_id"
    api_request "GET" "/servers/$server_id/status"
}

cmd_server_start() {
    local server_id="$1"
    if [[ -z "$server_id" ]]; then
        log_error "Server ID is required"
        return 1
    fi
    
    log_info "Starting server: $server_id"
    api_request "POST" "/servers/$server_id/start"
}

cmd_server_stop() {
    local server_id="$1"
    if [[ -z "$server_id" ]]; then
        log_error "Server ID is required"
        return 1
    fi
    
    log_info "Stopping server: $server_id"
    api_request "POST" "/servers/$server_id/stop"
}

cmd_server_restart() {
    local server_id="$1"
    if [[ -z "$server_id" ]]; then
        log_error "Server ID is required"
        return 1
    fi
    
    log_info "Restarting server: $server_id"
    api_request "POST" "/servers/$server_id/restart"
}

cmd_server_deploy() {
    local config_file="$1"
    if [[ -z "$config_file" ]]; then
        log_error "Configuration file is required"
        return 1
    fi
    
    if [[ ! -f "$config_file" ]]; then
        log_error "Configuration file not found: $config_file"
        return 1
    fi
    
    local config_data
    config_data=$(cat "$config_file")
    
    log_info "Deploying configuration from: $config_file"
    api_request "POST" "/deployments" "$config_data"
}

# User management commands
cmd_user_list() {
    log_info "Listing users..."
    api_request "GET" "/users"
}

cmd_user_create() {
    local email="$1"
    if [[ -z "$email" ]]; then
        log_error "Email is required"
        return 1
    fi
    
    local user_data
    user_data=$(jq -n --arg email "$email" '{email: $email}')
    
    log_info "Creating user: $email"
    api_request "POST" "/users" "$user_data"
}

cmd_user_delete() {
    local user_id="$1"
    if [[ -z "$user_id" ]]; then
        log_error "User ID is required"
        return 1
    fi
    
    log_info "Deleting user: $user_id"
    api_request "DELETE" "/users/$user_id"
}

# Policy management commands
cmd_policy_list() {
    log_info "Listing policies..."
    api_request "GET" "/policies"
}

cmd_policy_create() {
    local policy_file="$1"
    if [[ -z "$policy_file" ]]; then
        log_error "Policy file is required"
        return 1
    fi
    
    if [[ ! -f "$policy_file" ]]; then
        log_error "Policy file not found: $policy_file"
        return 1
    fi
    
    local policy_data
    policy_data=$(cat "$policy_file")
    
    log_info "Creating policy from: $policy_file"
    api_request "POST" "/policies" "$policy_data"
}

# Security commands
cmd_security_audit() {
    log_info "Running security audit..."
    api_request "POST" "/security/audit"
}

cmd_compliance_check() {
    log_info "Running compliance check..."
    api_request "POST" "/compliance/check"
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -s|--server)
                SERVER_URL="$2"
                shift 2
                ;;
            -t|--token)
                API_TOKEN="$2"
                shift 2
                ;;
            --timeout)
                TIMEOUT="$2"
                shift 2
                ;;
            -v|--verbose)
                VERBOSE="1"
                shift
                ;;
            -n|--dry-run)
                DRY_RUN="1"
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            --version)
                echo "TunnelForge Enterprise CLI v${CLI_VERSION}"
                exit 0
                ;;
            server)
                shift
                case $1 in
                    list)
                        cmd_server_list
                        ;;
                    status)
                        shift
                        cmd_server_status "$1"
                        ;;
                    start)
                        shift
                        cmd_server_start "$1"
                        ;;
                    stop)
                        shift
                        cmd_server_stop "$1"
                        ;;
                    restart)
                        shift
                        cmd_server_restart "$1"
                        ;;
                    deploy)
                        shift
                        cmd_server_deploy "$1"
                        ;;
                    *)
                        log_error "Unknown server command: $1"
                        exit 1
                        ;;
                esac
                exit 0
                ;;
            user)
                shift
                case $1 in
                    list)
                        cmd_user_list
                        ;;
                    create)
                        shift
                        cmd_user_create "$1"
                        ;;
                    delete)
                        shift
                        cmd_user_delete "$1"
                        ;;
                    *)
                        log_error "Unknown user command: $1"
                        exit 1
                        ;;
                esac
                exit 0
                ;;
            policy)
                shift
                case $1 in
                    list)
                        cmd_policy_list
                        ;;
                    create)
                        shift
                        cmd_policy_create "$1"
                        ;;
                    *)
                        log_error "Unknown policy command: $1"
                        exit 1
                        ;;
                esac
                exit 0
                ;;
            security)
                shift
                case $1 in
                    audit)
                        cmd_security_audit
                        ;;
                    *)
                        log_error "Unknown security command: $1"
                        exit 1
                        ;;
                esac
                exit 0
                ;;
            compliance)
                shift
                case $1 in
                    check)
                        cmd_compliance_check
                        ;;
                    *)
                        log_error "Unknown compliance command: $1"
                        exit 1
                        ;;
                esac
                exit 0
                ;;
            *)
                log_error "Unknown command: $1"
                show_help
                exit 1
                ;;
        esac
    done
}

# Check dependencies
check_dependencies() {
    local missing_deps=()
    
    command -v curl >/dev/null 2>&1 || missing_deps+=("curl")
    command -v jq >/dev/null 2>&1 || missing_deps+=("jq")
    
    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        log_error "Missing dependencies: ${missing_deps[*]}"
        log_error "Please install the missing dependencies and try again."
        exit 1
    fi
}

# Main function
main() {
    # Check dependencies
    check_dependencies
    
    # Load configuration
    load_config
    
    # Parse arguments
    if [[ $# -eq 0 ]]; then
        show_help
        exit 1
    fi
    
    parse_args "$@"
    
    # Save configuration if changed
    save_config
}

# Run main function
main "$@"